{
  "name": "reporte-ciudadano",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db",
    "db:syntax": "node scripts/check-sql.mjs",
